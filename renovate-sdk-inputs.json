{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Literal SDK inputs in fully qualified calls to nddev-ci"
  ],
  "customManagers": [
    {
      "depTypeTemplate": "ci-sdk",
      "customType": "jsonata",
      "managerFilePatterns": [
        "/(^|/)\\.github/(?:workflows|actions)/.+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "fileFormat": "yaml",
      "yamlMaxAliasCount": 0,
      "matchStrings": [
        "($sdk := {\"rust-version\":{\"depName\":\"rust\",\"datasource\":\"rust-version\"},\"python-version\":{\"depName\":\"python\",\"datasource\":\"python-version\"},\"node-version\":{\"depName\":\"node\",\"datasource\":\"node-version\",\"versioning\":\"node\"},\"bun-version\":{\"depName\":\"bun\",\"datasource\":\"npm\",\"versioning\":\"npm\"},\"uv-version\":{\"depName\":\"astral-sh/uv\",\"datasource\":\"github-releases\",\"versioning\":\"npm\"},\"java-version\":{\"depName\":\"java-jdk\",\"datasource\":\"java-version\"},\"go-version\":{\"depName\":\"go\",\"datasource\":\"golang-version\"},\"flutter-version\":{\"depName\":\"flutter\",\"datasource\":\"flutter-version\"}}; **[$type(uses) = \"string\" and $exists($match(uses, /^NDDev-Technocracy-OpenNetwork\\/nddev-ci\\/.+@/i))].with.$each($, function($value, $key) {($spec := $lookup($sdk, $key); ($spec and $type($value) = \"string\" and $exists($match($value, /^[0-9]+\\.[0-9]+\\.[0-9]+([+.-][0-9A-Za-z.-]+)?$/))) ? $merge([$spec, {\"currentValue\": $value}]))}))"
      ]
    }
  ]
}
